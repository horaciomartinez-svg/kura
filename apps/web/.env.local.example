# Supabase (frontend) — copia este archivo a .env.local con los valores reales.
# Usa la nueva API key publicable (formato sb_publishable_...), NUNCA la service
# role ni ninguna clave secreta en el frontend.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key

# URL de la API Edge (Cloudflare Workers). Por defecto http://localhost:8787.
# NEXT_PUBLIC_API_URL=http://localhost:8787

# Solo para uso server-side futuro (nunca exponer al navegador; opcional):
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-service-role-key
